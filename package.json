{
  "name": "@dcl/hooks",
  "version": "0.0.0-development",
  "main": "esm/index.js",
  "module": "esm/index.js",
  "type": "module",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "npm run build:esm",
    "build:esm": "tsc -p tsconfig.esm.json",
    "dev": "tsc --watch --outDir dist",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,mdx,css}'",
    "lint": "eslint ./src",
    "lint:fix": "npm run lint -- --fix",
    "lint:pkg": "npmPkgJsonLint . --maxWarnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "npm run test -- --coverage"
  },
  "dependencies": {
    "@formatjs/intl": "3.1.8",
    "@segment/analytics-next": "1.84.3",
    "@sentry/browser": "9.0.0",
    "isbot": "5.1.25",
    "ua-parser-js": "2.0.7"
  },
  "peerDependencies": {
    "decentraland-crypto-fetch": ">=2.0.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@dcl/eslint-config": "^2.2.1",
    "@testing-library/react": "14.3.1",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.75",
    "@types/react": "18.3.18",
    "@types/ua-parser-js": "0.7.39",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "decentraland-crypto-fetch": "^3.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-jest": "3.0.2",
    "eslint-import-resolver-typescript": "3.7.0",
    "eslint-plugin-autofix": "2.2.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-react": "7.37.4",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "npm-package-json-lint": "9.1.0",
    "prettier": "3.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3",
    "typescript-eslint": "7.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decentraland/hooks.git"
  },
  "keywords": [
    "decentraland",
    "hooks"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/decentraland/hooks/issues"
  },
  "homepage": "https://github.com/decentraland/hooks#readme",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^test/(.*)$": "<rootDir>/test/$1",
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ]
  }
}
